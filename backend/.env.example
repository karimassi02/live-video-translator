# --- Clés API (obligatoires) ---
# Deepgram : https://console.deepgram.com (200 $ de crédit offerts à l'inscription)
DEEPGRAM_API_KEY=
# DeepL : https://www.deepl.com/pro-api (plan Developer gratuit : crédit unique de 1M caractères)
DEEPL_API_KEY=
# Anthropic : https://console.anthropic.com (crédit prépayé) — requis si FINAL_TRANSLATOR=claude
ANTHROPIC_API_KEY=

# --- Langues ---
SOURCE_LANG=fr
# Codes DeepL : EN-GB, EN-US, DE, ES, IT...
TARGET_LANG=EN-GB

# --- Traduction ---
# Moteur des phrases FINALES : "claude" (LLM, rend l'argot par le sens, ~0,45 $/h)
# ou "deepl" (gratuit, mais mot-à-mot sur le registre familier).
FINAL_TRANSLATOR=claude
# Modèle Claude pour les finales (haiku = le plus rapide / le moins cher).
CLAUDE_MODEL=claude-haiku-4-5
# true : affiche aussi une ligne « live » qui s'écrit pendant la phrase (via DeepL).
# false (défaut) : chaque phrase apparaît d'un bloc une fois la réplique terminée.
TRANSLATE_PARTIALS=false

# --- STT ---
# nova-2 est un bon défaut pour le français en streaming.
DEEPGRAM_MODEL=nova-2
# Silence (ms) avant de considérer la réplique terminée. Plus bas = sous-titres
# plus réactifs, mais phrases plus souvent coupées en fragments (100-500).
DEEPGRAM_ENDPOINTING=200

# --- Réglages avancés ---
# Fréquence max de traduction des sous-titres partiels (secondes)
PARTIAL_TRANSLATE_INTERVAL=0.7
PORT=8710
